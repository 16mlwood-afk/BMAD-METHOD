#!/usr/bin/env sh
# .githooks/pre-commit — fork-distributed gate dispatcher (STD-HOOKACTIVATE-001).
# Same contract as pre-push (see that file's header): thin dispatcher that runs
# the repo's registered pre-commit gates, then exits. Absent gate scripts are
# skipped. Most deterministic gates run at pre-push — this exists for symmetry
# and for any commit-time gate a repo registers.
#
# Two registries are read (gap 496 — fork-gate retrofit):
#   .githooks/gates.conf      — PROJECT-owned (create-only on sync; per-repo gate choices)
#   .githooks/gates.d/*.conf  — FORK-owned drop-ins (always distributed by sync, so a NEW
#                               fork gate retrofits the fleet without a per-repo edit)
# Do not list one script in both (it would run twice). Fork gates live in gates.d.
set -eu

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
status=0
RAN=""   # dedup: a script listed in both gates.conf and gates.d runs only once

# Run every gate registered for event $2 in conf file $1 (absent file / script → no-op).
run_gates_from() {
  conf="$1"
  want="$2"
  [ -f "$conf" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | \#*) continue ;; esac
    event=$(printf '%s' "$line" | awk '{print $1}')
    [ "$event" = "$want" ] || continue
    # strip the event, any trailing inline "# comment", and trailing whitespace —
    # without the comment strip, "$ROOT/$cmd" includes the comment, [ -f ] fails,
    # and the gate is SILENTLY skipped (bit every gates.d conf, which carry
    # inline comments — the design-brief/dataflow gates were inert fleet-wide)
    cmd=$(printf '%s' "$line" | sed 's/^[^[:space:]]*[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//')
    [ -n "$cmd" ] || continue
    case "$RAN" in *"|$cmd|"*) continue ;; esac   # already ran this script
    RAN="$RAN|$cmd|"
    script="$ROOT/$cmd"
    [ -f "$script" ] || continue
    printf 'pre-commit gate: %s\n' "$cmd" >&2
    if ! sh "$script" </dev/null; then
      printf 'pre-commit BLOCKED by %s. Override (logged): git commit --no-verify\n' "$cmd" >&2
      status=1
    fi
  done < "$conf"
}

run_gates_from "$ROOT/.githooks/gates.conf" pre-commit
if [ -d "$ROOT/.githooks/gates.d" ]; then
  for drop in "$ROOT"/.githooks/gates.d/*.conf; do
    [ -f "$drop" ] || continue
    run_gates_from "$drop" pre-commit
  done
fi

exit "$status"
