#!/usr/bin/env sh
# Fork pre-commit — migrated from .husky/pre-commit to .githooks/ as the canonical,
# worktree-safe hook mechanism (STD-HOOKACTIVATE-001; husky retired here so the fork
# dogfoods the same core.hooksPath=.githooks activation it distributes to projects).
# This is the FORK's own bespoke hook — NOT the generic dispatcher in custom/githooks/.

# Auto-fix changed files and stage them
npx --no-install lint-staged

# Validate.
# Fast path for fork-tooling-only commits (custom/, docs/, *.md, *.sh, the onboarding/global-asset
# tooling): run the fork-relevant validators (refs + lint + budget) and SKIP the upstream product
# suites (test:install / test:urls / test:channels) that such a diff can't affect. Any change that
# touches an upstream/product path falls back to the full suite. See fork-gaps "Full upstream test
# suite on every fork push".
changed="$(git diff --cached --name-only)"
non_fork="$(printf '%s\n' "$changed" | grep -cvE '^(custom/|docs/|\.githooks/|\.husky/|\.gitignore$|STATUS\.md$|STATUS-archive\.md$|onboarding-playbook\.version$|install-global-assets\.sh$|onboard-project\.sh$|check-[a-z-]*\.sh$|standards-drift-report\.sh$|.*\.md$)')"
if [ -z "$changed" ] || [ "$non_fork" -gt 0 ]; then
  npm test
else
  echo "pre-commit: fork-tooling-only diff → fast validators (skipping upstream install/urls/channels suites)"
  npm run test:refs && npm run lint && npm run lint:md && npm run format:check && npm run validate:budget && npm run validate:close-out && npm run check:completion -- --strict
fi

# Validate hooks actually function (exit 0 + correct stdin contract) so a broken
# hook can't ship silently — see docs/hooks-registry.md + fork-gaps "Hooks ship unvalidated".
bash ./check-hooks-smoke.sh

# Validate docs (links + sidebar) only when docs change.
# NOTE (fork-gap #94): the full astro site build (npm run docs:build) is intentionally
# NOT in the commit gate. It is heavyweight + stateful and fails on astro build-cache
# artifacts (e.g. a stale build/site/pages/404.astro.mjs) INDEPENDENT of the diff — so a
# markdown-only / docs/fork-gaps.md edit that touches no site logic was blocked, and the
# only escape (--no-verify) also discarded the cheap content validators that ARE the point
# of the gate. Links + sidebar are diff-relevant and fast; keep them here. The full SSG
# build runs at deploy/CI where a clean environment exists.
if git diff --cached --name-only | grep -Eq '^docs/'; then
  npm run docs:validate-links
  npm run docs:validate-sidebar
fi
